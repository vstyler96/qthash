[Desktop Entry]
Name=QtHash
GenericName=Checksum Calculator
Comment=Calculate message digests or checksums
Keywords=hash;checksum;digest;md5;sha1;sha256;crc32;
TryExec=qthash
Exec=qthash %U
Icon=dev.kingbeencent.qthash
StartupWMClass=dev.kingbeencent.qthash
Terminal=false
Type=Application
StartupNotify=true
Categories=Utility;Security;Qt;
